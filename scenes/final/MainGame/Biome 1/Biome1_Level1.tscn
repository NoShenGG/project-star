[sub_resource type="GDScript" id="GDScript_f6gd0"]
resource_name = "IntroductionCutscene"
script/source = "extends Camera3D

@export var duration : float = 3

@export var game_camera : Camera3D
var animation_transform : Transform3D
@export var curve : Curve

@export var time_to_game_camera : float = 3

var playing : bool = false
var transitioning_to_game_camera : bool = false

func _ready() -> void:
	current = true
	playing = true
	await get_tree().create_timer(duration).timeout
	lerp_to_game_camera()

func end_interrupt():
	if (playing and !transitioning_to_game_camera):
		lerp_to_game_camera()

func lerp_to_game_camera():
	if (transitioning_to_game_camera or !playing): return
	print(\"transitioning\")
	
	animation_transform = global_transform
	var time : float = 0
	var start_fov : float = fov
	
	transitioning_to_game_camera = true
	
	while (time <= time_to_game_camera):
		var weight : float = curve.sample(time / time_to_game_camera)
		global_position = animation_transform.origin.lerp(game_camera.global_position, weight)
		global_basis = animation_transform.basis.slerp(game_camera.global_basis, weight)
		time += get_process_delta_time()
		await RenderingServer.frame_pre_draw
		fov = lerpf(start_fov, game_camera.fov, weight)
		await get_tree().process_frame
	transitioning_to_game_camera = false
	playing = false
	current = false
"

